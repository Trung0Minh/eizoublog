generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  username          String    @unique
  passwordHash      String?
  bio               String?   @db.Text
  avatarUrl         String?
  avatarOriginalUrl String?
  displayRoleName   String?
  displayRoleColor  String?
  displayRoleLocked Boolean   @default(false)
  emailVerified     DateTime?
  image             String?
  role              Role      @default(WRITER)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  posts              Post[]                  @relation("PostPrimaryAuthor")
  coAuthoredPosts    PostAuthor[]
  accounts           Account[]
  sessions           Session[]
  invitesSent        Invite[]                @relation("InviteCreatedBy")
  passwordResets     PasswordResetToken[]
  comments           Comment[]
  notifications      Notification[]
  awardEventsCreated AwardEvent[]            @relation("AwardEventCreatedBy")
  awardEventRooms    AwardEventRoom[]
  awardEventComments AwardEventRoomComment[]

  @@index([username])
  @@index([role, createdAt(sort: Desc)])
  @@index([role, name])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum Role {
  WRITER
  ADMIN
  REVOKED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Invite {
  id          String       @id @default(cuid())
  email       String
  token       String       @unique @default(cuid())
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  createdById String

  createdBy User @relation("InviteCreatedBy", fields: [createdById], references: [id])

  @@index([token])
  @@index([email])
  @@index([createdById])
  @@index([status, expiresAt, createdAt(sort: Desc)])
  @@map("invites")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model Post {
  id              String                   @id @default(cuid())
  title           String
  slug            String                   @unique
  excerpt         String?                  @db.Text
  excerptContent  Json?
  coverUrl        String?
  coverAlt        String?
  content         Json
  contentText     String?                  @db.Text
  status          PostStatus               @default(DRAFT)
  draftVisibility DraftVisibility          @default(PRIVATE)
  publishedAt     DateTime?
  moderationLockedAt DateTime?
  removedFromStatus  PostStatus?
  removedAt          DateTime?
  version            Int                    @default(1)
  lastSavedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  authorId        String
  author          User                     @relation("PostPrimaryAuthor", fields: [authorId], references: [id])
  coAuthors       PostAuthor[]
  categoryId      String?
  category        Category?                @relation(fields: [categoryId], references: [id])
  tags            PostTag[]
  comments        Comment[]
  finalAwardEvent AwardEvent?              @relation("AwardEventFinalPost")
  awardEventRooms AwardEventRoom[]         @relation("AwardEventRoomSelectedPost")
  searchVector    Unsupported("tsvector")? @map("search_vector")

  @@index([slug])
  @@index([status, publishedAt(sort: Desc)])
  @@index([authorId])
  @@index([categoryId])
  @@index([categoryId, status, publishedAt(sort: Desc), updatedAt(sort: Desc)])
  @@index([authorId, status, publishedAt(sort: Desc), updatedAt(sort: Desc)])
  @@index([authorId, status, updatedAt(sort: Desc)])
  @@map("posts")
}

enum CoAuthorStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  REMOVED
}

enum DraftVisibility {
  PRIVATE
  CO_AUTHORS
}

model AwardEvent {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  intro       Json?
  introText   String?          @db.Text
  coverUrl    String?
  coverAlt    String?
  status      AwardEventStatus @default(OPEN)
  openedAt    DateTime?
  closedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdById String
  finalPostId String?          @unique
  editorialContentEditedAt DateTime?
  categoryId  String?

  createdBy User             @relation("AwardEventCreatedBy", fields: [createdById], references: [id])
  finalPost Post?            @relation("AwardEventFinalPost", fields: [finalPostId], references: [id])
  category  Category?        @relation(fields: [categoryId], references: [id])
  rooms     AwardEventRoom[]
  tags      AwardEventTag[]

  @@index([status, createdAt(sort: Desc)])
  @@index([createdById])
  @@index([categoryId])
  @@map("award_events")
}

enum AwardEventStatus {
  OPEN
  CLOSED
}

model AwardEventRoom {
  id          String                   @id @default(cuid())
  eventId     String
  writerId    String
  postId      String?
  writerIntro String?                  @db.Text
  submittedContent     Json?
  submittedPostId      String?
  submittedPostTitle   String?
  submittedPostVersion Int?
  submittedWriterIntro String?                  @db.Text
  content     Json
  contentText String?                  @db.Text
  visibility  AwardEventRoomVisibility @default(PRIVATE)
  status      AwardEventRoomStatus     @default(DRAFT)
  order       Int                      @default(0)
  excludedAt  DateTime?
  submittedAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  event        AwardEvent              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  writer       User                    @relation(fields: [writerId], references: [id], onDelete: Cascade)
  selectedPost Post?                   @relation("AwardEventRoomSelectedPost", fields: [postId], references: [id], onDelete: SetNull)
  comments     AwardEventRoomComment[]

  @@unique([eventId, writerId])
  @@index([eventId, status, order])
  @@index([postId])
  @@index([writerId, updatedAt(sort: Desc)])
  @@map("award_event_rooms")
}

enum AwardEventRoomStatus {
  DRAFT
  SUBMITTED
}

enum AwardEventRoomVisibility {
  PRIVATE
  PARTICIPANTS
}

model AwardEventRoomComment {
  id        String   @id @default(cuid())
  roomId    String
  authorId  String
  content   String   @db.Text
  isPrivate Boolean  @default(false)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  room   AwardEventRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@map("award_event_room_comments")
}

model AwardEventTag {
  eventId String
  tagId   String

  event AwardEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag   Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([eventId, tagId])
  @@index([tagId])
  @@map("award_event_tags")
}

model PostAuthor {
  postId String
  userId String
  order  Int            @default(0)
  status CoAuthorStatus @default(PENDING)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_authors")
}

model Category {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  description String?      @db.Text
  createdAt   DateTime     @default(now())
  posts       Post[]
  awardEvents AwardEvent[]

  @@index([slug])
  @@map("categories")
}

model Tag {
  id          String          @id @default(cuid())
  name        String          @unique
  slug        String          @unique
  createdAt   DateTime        @default(now())
  posts       PostTag[]
  awardEvents AwardEventTag[]

  @@index([slug])
  @@map("tags")
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

model Comment {
  id          String        @id @default(cuid())
  postId      String
  parentId    String?
  authorName  String
  authorEmail String
  authorId    String?
  content     String        @db.Text
  status      CommentStatus @default(APPROVED)
  notifyReply Boolean       @default(true)
  isRead      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent      Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies     Comment[]     @relation("CommentReplies")
  author      User?         @relation(fields: [authorId], references: [id])

  @@index([postId, status])
  @@index([parentId])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("comments")
}

enum CommentStatus {
  APPROVED
  SPAM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  readAt    DateTime?
  createdAt DateTime         @default(now())
  data      Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("notifications")
}

enum NotificationType {
  COAUTHOR_ACCEPTED
  COAUTHOR_DECLINED
  DURABILITY_ALERT
  POST_MODERATION
}

enum PostRevisionKind {
  AUTO_CHECKPOINT
  BASELINE
  DELETE_GUARD
  MANUAL_SAVE
  PUBLISH
  RESTORE
}

model PostRevision {
  id            String           @id @default(cuid())
  postId        String
  sourceVersion Int
  kind          PostRevisionKind
  snapshot      Json
  checksum      String
  actorId       String?
  createdAt     DateTime         @default(now())
  expiresAt     DateTime?

  @@index([postId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("post_revisions")
}

enum PostAuditAction {
  CONFLICT
  DELETE
  MODERATION
  PURGE
  RESTORE
  SAVE
}

model PostAuditEvent {
  id            String          @id @default(cuid())
  postId        String
  actorId       String?
  action        PostAuditAction
  sourceVersion Int?
  metadata      Json
  createdAt     DateTime        @default(now())

  @@index([postId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("post_audit_events")
}

enum DurabilitySeverity {
  CRITICAL
  HEALTHY
  UNKNOWN
  WARNING
}

model DurabilityStatus {
  id                 String             @id @default("primary")
  severity           DurabilitySeverity @default(UNKNOWN)
  databaseBytes      BigInt?
  capacityBytes      BigInt?
  latestBackupAt     DateTime?
  latestMediaBackupAt DateTime?
  checkedAt          DateTime           @default(now())
  issues             Json

  @@map("durability_status")
}

enum MediaCleanupStatus {
  COMPLETE
  FAILED
  PENDING
}

model MediaCleanupJob {
  id            String             @id @default(cuid())
  objectKeys    Json
  status        MediaCleanupStatus @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now())
  lastError     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, nextAttemptAt])
  @@map("media_cleanup_jobs")
}

model NewsletterSubscriber {
  id                  String                         @id @default(cuid())
  email               String                         @unique
  status              SubscriberStatus               @default(ACTIVE)
  token               String                         @unique @default(cuid())
  subscribedAt        DateTime                       @default(now())
  unsubscribedAt      DateTime?
  broadcastRecipients NewsletterBroadcastRecipient[]

  @@index([email])
  @@index([token])
  @@index([status])
  @@map("newsletter_subscribers")
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum NewsletterBroadcastStatus {
  QUEUED
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum NewsletterRecipientStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model NewsletterBroadcast {
  id               String                         @id @default(cuid())
  subject          String
  previewText      String?
  customBody       String?                        @db.Text
  featuredCoverUrl String?
  featuredExcerpt  String?                        @db.Text
  featuredTitle    String?
  featuredUrl      String?
  status           NewsletterBroadcastStatus      @default(QUEUED)
  totalCount       Int                            @default(0)
  sentCount        Int                            @default(0)
  failedCount      Int                            @default(0)
  createdAt        DateTime                       @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  recipients       NewsletterBroadcastRecipient[]

  @@index([status, createdAt(sort: Asc)])
  @@map("newsletter_broadcasts")
}

model NewsletterBroadcastRecipient {
  id             String                    @id @default(cuid())
  broadcastId    String
  subscriberId   String
  email          String
  unsubscribeUrl String
  status         NewsletterRecipientStatus @default(PENDING)
  attempts       Int                       @default(0)
  nextAttemptAt  DateTime                  @default(now())
  claimedAt      DateTime?
  sentAt         DateTime?
  lastError      String?                   @db.Text
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  broadcast      NewsletterBroadcast       @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  subscriber     NewsletterSubscriber      @relation(fields: [subscriberId], references: [id])

  @@unique([broadcastId, subscriberId])
  @@index([subscriberId])
  @@index([status, nextAttemptAt, claimedAt])
  @@index([broadcastId, status])
  @@map("newsletter_broadcast_recipients")
}

enum AnalyticsEventType {
  PAGE_VIEW
  POST_READ
  COMMENT_SUBMITTED
  NEWSLETTER_SUBSCRIBED
  SEARCH_PERFORMED
}

model AnalyticsEvent {
  id              String             @id @default(cuid())
  type            AnalyticsEventType
  path            String?
  postSlug        String?
  searchQuery     String?
  visitorHash     String?
  sessionHash     String?
  durationSeconds Int?
  createdAt       DateTime           @default(now())

  @@index([type, createdAt(sort: Desc)])
  @@index([path, createdAt(sort: Desc)])
  @@index([postSlug, type, createdAt(sort: Desc)])
  @@index([visitorHash, createdAt(sort: Desc)])
  @@map("analytics_events")
}

model AnalyticsDailySummary {
  id                String   @id @default(cuid())
  day               DateTime @db.Date
  pageviews         Int      @default(0)
  visitors          Int      @default(0)
  sessions          Int      @default(0)
  reads             Int      @default(0)
  comments          Int      @default(0)
  newsletterSignups Int      @default(0)
  searches          Int      @default(0)
  totalReadSeconds  Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@unique([day])
  @@index([day])
  @@map("analytics_daily_summaries")
}

model AnalyticsDailyPage {
  id           String    @id @default(cuid())
  day          DateTime  @db.Date
  path         String
  postSlug     String?
  pageviews    Int       @default(0)
  reads        Int       @default(0)
  comments     Int       @default(0)
  lastViewedAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([day, path])
  @@index([path, day(sort: Desc)])
  @@index([postSlug, day(sort: Desc)])
  @@index([day, pageviews(sort: Desc)])
  @@map("analytics_daily_pages")
}

model AnalyticsDailyVisitor {
  id          String   @id @default(cuid())
  day         DateTime @db.Date
  visitorHash String
  createdAt   DateTime @default(now())

  @@unique([day, visitorHash])
  @@map("analytics_daily_visitors")
}

model AnalyticsDailySession {
  id          String   @id @default(cuid())
  day         DateTime @db.Date
  sessionHash String
  createdAt   DateTime @default(now())

  @@unique([day, sessionHash])
  @@map("analytics_daily_sessions")
}

model SitePage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     Json
  contentText String?  @db.Text
  updatedAt   DateTime @updatedAt

  @@map("site_pages")
}
