# Database (Supabase)
# Recommended runtime Supabase pooler params: ?pgbouncer=true&connection_limit=10
DATABASE_URL=""
DIRECT_URL=""

# Auth.js / NextAuth
AUTH_URL="http://localhost:3000"
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Private durability backup bucket (use credentials separate from production media)
R2_BACKUP_ACCESS_KEY_ID=""
R2_BACKUP_SECRET_ACCESS_KEY=""
R2_BACKUP_BUCKET_NAME=""
R2_BACKUP_MANIFEST_KEY="manifests/latest.json"

# Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Vercel Cron authentication (random string, at least 16 characters)
CRON_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Anime Blog"

# Internal analytics
# Optional. Falls back to NEXTAUTH_SECRET/AUTH_SECRET when blank.
ANALYTICS_HASH_SALT=""

# Post durability
# Set this to the production database quota in bytes.
DATABASE_CAPACITY_BYTES=""
DURABILITY_ALERT_EMAILS=""
# Keep false until a verified backup and restore drill have completed.
POST_HARD_DELETE_ENABLED="false"
